NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csmju_software_license_manager_db
DATABASE_POOL_MAX=5

CORE_HUB_URL=http://localhost:3100
CORE_HUB_WEB_URL=http://localhost:3100
CORE_HUB_JWKS_URL=http://localhost:3100/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000

CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

SUBSYSTEM_ID=csmju-software-license-manager
SUBSYSTEM_NAME=CSMJU Software License Manager

JWT_CLOCK_TOLERANCE_SEC=5
